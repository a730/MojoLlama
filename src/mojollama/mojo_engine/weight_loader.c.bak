#define N_FILES 436

int64_t load_weight(int64_t idx) {
    if (idx < 0 || idx >= N_FILES) return 0;
    FILE* f = fopen(_paths[idx], "rb");
    if (!f) return 0;
    fseek(f, 0, SEEK_END); size_t sz = ftell(f); fseek(f, 0, SEEK_SET);
    uint8_t* buf = (uint8_t*)malloc(sz);
    if (!buf) { fclose(f); return 0; }
    fread(buf, 1, sz, f); fclose(f);
    return (int64_t)buf;
}

void free_weight(int64_t ptr) { free((void*)ptr); }

int64_t weight_size(int64_t idx) {
    if (idx < 0 || idx >= N_FILES) return 0;
    FILE* f = fopen(_paths[idx], "rb");
    if (!f) return 0;
    fseek(f, 0, SEEK_END); int64_t sz = ftell(f); fclose(f);
    return sz;
}

